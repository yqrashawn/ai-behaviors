#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_DIR="$HOME/.claude"
HOOKS_DIR="$CLAUDE_DIR/hooks"
SETTINGS="$CLAUDE_DIR/settings.json"

echo "Installing ai-behaviors hooks"

mkdir -p "$HOOKS_DIR"

# --- Symlink hooks ---
ln -sf "$REPO_DIR/hooks/inject-behaviors.sh" "$HOOKS_DIR/inject-behaviors.sh"
echo "  symlinked: inject-behaviors.sh → $HOOKS_DIR/"
ln -sf "$REPO_DIR/hooks/enforce-mode.sh" "$HOOKS_DIR/enforce-mode.sh"
echo "  symlinked: enforce-mode.sh → $HOOKS_DIR/"

# --- Register hooks in settings.json ---
if [ ! -f "$SETTINGS" ]; then
  cat > "$SETTINGS" <<'EOF'
{
  "hooks": {}
}
EOF
fi

inject_cmd="$HOOKS_DIR/inject-behaviors.sh"
if ! grep -q "inject-behaviors.sh" "$SETTINGS" 2>/dev/null; then
  tmp=$(mktemp)
  jq --arg cmd "$inject_cmd" '
    .hooks //= {} |
    .hooks.UserPromptSubmit //= [] |
    .hooks.UserPromptSubmit += [{"hooks": [{"type": "command", "command": $cmd, "timeout": 5}]}]
  ' "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  registered: inject-behaviors.sh in settings.json"
else
  echo "  already registered: inject-behaviors.sh"
fi

enforce_cmd="$HOOKS_DIR/enforce-mode.sh"
if ! grep -q "enforce-mode.sh" "$SETTINGS" 2>/dev/null; then
  tmp=$(mktemp)
  jq --arg cmd "$enforce_cmd" '
    .hooks //= {} |
    .hooks.PreToolUse //= [] |
    .hooks.PreToolUse += [{"hooks": [{"type": "command", "command": $cmd, "timeout": 3}]}]
  ' "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  registered: enforce-mode.sh in settings.json"
else
  echo "  already registered: enforce-mode.sh"
fi

echo ""
echo "Done. Use #hashtags in Claude Code prompts:"
echo "  Fix the auth bug #=code #challenge"
echo "  Review this PR #=review #deep #challenge"
echo ""
echo "Tool enforcement is active: modes like #=review, #=research"
echo "will block Edit/Write tools. See blocked-tools files per mode."
