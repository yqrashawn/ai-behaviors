#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_DIR="$HOME/.claude"
HOOKS_DIR="$CLAUDE_DIR/hooks"
SETTINGS="$CLAUDE_DIR/settings.json"

echo "Installing ai-behaviors hook"

mkdir -p "$HOOKS_DIR"

# --- Symlink hook ---
ln -sf "$REPO_DIR/hooks/inject-behaviors.bb" "$HOOKS_DIR/inject-behaviors.bb"
echo "  symlinked: inject-behaviors.bb → $HOOKS_DIR/"

# --- Register hook in settings.json ---
if [ ! -f "$SETTINGS" ]; then
  cat > "$SETTINGS" <<'EOF'
{
  "hooks": {}
}
EOF
fi

inject_cmd="$HOOKS_DIR/inject-behaviors.bb"
if ! grep -q "inject-behaviors.bb" "$SETTINGS" 2>/dev/null; then
  tmp=$(mktemp)
  jq --arg cmd "$inject_cmd" '
    .hooks //= {} |
    .hooks.UserPromptSubmit //= [] |
    .hooks.UserPromptSubmit += [{"hooks": [{"type": "command", "command": $cmd, "timeout": 5}]}]
  ' "$SETTINGS" > "$tmp" && cat "$tmp" > "$SETTINGS" && rm "$tmp"
  echo "  registered: inject-behaviors.bb in settings.json"
else
  echo "  already registered: inject-behaviors.bb"
fi

# --- Symlink agents ---
AGENTS_DIR="$CLAUDE_DIR/agents"
mkdir -p "$AGENTS_DIR"
agent_count=0
for agent_file in "$REPO_DIR/agents"/*.md; do
  [ -f "$agent_file" ] || continue
  agent_name=$(basename "$agent_file")
  ln -sf "$agent_file" "$AGENTS_DIR/$agent_name"
  agent_count=$((agent_count + 1))
done
if [ "$agent_count" -gt 0 ]; then
  echo "  symlinked: $agent_count agents → $AGENTS_DIR/"
fi

echo ""
echo "Done. Use #hashtags in Claude Code prompts:"
echo "  Fix the auth bug #=code #challenge"
echo "  Review this PR #=review #deep #challenge"
echo ""
echo "Agents installed (invoke with @agent-name or natural language):"
for agent_file in "$REPO_DIR/agents"/*.md; do
  [ -f "$agent_file" ] || continue
  agent_name=$(basename "$agent_file" .md)
  echo "  @$agent_name"
done
